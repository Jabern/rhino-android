 }
 
 #if defined (SIOCGIFHWADDR) && defined (HAVE_STRUCT_IFREQ_IFR_HWADDR)
+/* A locally administered unicast address, stable for this machine and interface. */
+static void make_local_mac( const char *name, BYTE *addr )
+{
+    UINT64 hash = 0xcbf29ce484222325ull;
+    char id[64];
+    int fd, len = 0, i;
+
+    const char *dir = getenv( "WINE_DMI_DIR" );
+    char path[PATH_MAX];
+
+    fd = open( "/etc/machine-id", O_RDONLY );
+    if (fd == -1 && dir && snprintf( path, sizeof(path), "%s/machine-id", dir ) < sizeof(path))
+        fd = open( path, O_RDONLY );
+    if (fd != -1)
+    {
+        if ((len = read( fd, id, sizeof(id) )) < 0) len = 0;
+        close( fd );
+    }
+    for (i = 0; i < len; i++) hash = (hash ^ (BYTE)id[i]) * 0x100000001b3ull;
+    for (i = 0; name[i]; i++) hash = (hash ^ (BYTE)name[i]) * 0x100000001b3ull;
+
+    addr[0] = 0x02;
+    for (i = 1; i < ETH_ALEN; i++) addr[i] = hash >> (8 * i);
+}
+
 static NTSTATUS if_get_physical( const char *name, UINT *type, IF_PHYSICAL_ADDRESS *phys_addr )
 {
     int fd, size, i;
