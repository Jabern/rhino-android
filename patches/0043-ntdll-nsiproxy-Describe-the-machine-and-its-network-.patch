     if (ioctl( fd, SIOCGIFHWADDR, &ifr ))
     {
+        if ((errno == EACCES || errno == EPERM) && !ioctl( fd, SIOCGIFFLAGS, &ifr ))
+        {
+            /* Android hides hardware addresses from apps; make up a stable one */
+            if (ifr.ifr_flags & IFF_LOOPBACK) *type = MIB_IF_TYPE_LOOPBACK;
+            else if (ifr.ifr_flags & IFF_POINTOPOINT) *type = MIB_IF_TYPE_PPP;
+            else
+            {
+                *type = MIB_IF_TYPE_ETHERNET;
+                phys_addr->Length = ETH_ALEN;
+                make_local_mac( name, phys_addr->Address );
+            }
+            goto wireless;
+        }
         ret = STATUS_DEVICE_DATA_ERROR;
         goto err;
     }
@@ -176,6 +218,7 @@ static NTSTATUS if_get_physical( const char *name, UINT *type, IF_PHYSICAL_ADDRE
     if (*type == MIB_IF_TYPE_OTHER && !ioctl( fd, SIOCGIFFLAGS, &ifr ) && ifr.ifr_flags & IFF_POINTOPOINT)
         *type = MIB_IF_TYPE_PPP;
 
+wireless:
 #ifdef HAVE_LINUX_WIRELESS_H
     if (*type == MIB_IF_TYPE_ETHERNET)
     {
@@ -307,6 +350,86 @@ static struct if_entry *add_entry( UINT index, char *name )
     return entry;
 }
 
+/* Android apps may not use netlink, which getifaddrs() needs; build the IPv4
+ * part of its list from SIOCGIFCONF instead. Freed with nsi_freeifaddrs(). */
+static char ifconf_list;
+
+int nsi_getifaddrs( struct ifaddrs **list )
+{
+    struct entry { struct ifaddrs ifa; struct sockaddr_in addr, mask; char name[IFNAMSIZ]; } *entries;
+    struct ifreq reqs[32];
+    struct ifconf conf;
+    int fd, i, count;
+
+    if (!getifaddrs( list )) return 0;
+    if (errno != EACCES && errno != EPERM) return -1;
+
+    if ((fd = socket( PF_INET, SOCK_DGRAM, 0 )) == -1) return -1;
+    conf.ifc_len = sizeof(reqs);
+    conf.ifc_req = reqs;
+    if (ioctl( fd, SIOCGIFCONF, &conf ) || !(count = conf.ifc_len / sizeof(*reqs)) ||
+        !(entries = calloc( count, sizeof(*entries) )))
+    {
+        close( fd );
+        return -1;
+    }
+    for (i = 0; i < count; i++)
+    {
+        struct ifreq req = reqs[i];
+
+        memcpy( entries[i].name, reqs[i].ifr_name, IFNAMSIZ - 1 );
+        memcpy( &entries[i].addr, &reqs[i].ifr_addr, sizeof(entries[i].addr) );
+        entries[i].mask.sin_family = AF_INET;
+        if (!ioctl( fd, SIOCGIFNETMASK, &req )) memcpy( &entries[i].mask, &req.ifr_netmask, sizeof(entries[i].mask) );
+        req = reqs[i];
+        if (!ioctl( fd, SIOCGIFFLAGS, &req )) entries[i].ifa.ifa_flags = req.ifr_flags;
+        entries[i].ifa.ifa_name = entries[i].name;
+        entries[i].ifa.ifa_addr = (struct sockaddr *)&entries[i].addr;
+        entries[i].ifa.ifa_netmask = (struct sockaddr *)&entries[i].mask;
+        entries[i].ifa.ifa_data = &ifconf_list;
+        entries[i].ifa.ifa_next = i + 1 < count ? &entries[i + 1].ifa : NULL;
+    }
+    close( fd );
+    *list = &entries[0].ifa;
+    return 0;
+}
+
+void nsi_freeifaddrs( struct ifaddrs *list )
+{
+    if (list && list->ifa_data == &ifconf_list) free( list );
+    else freeifaddrs( list );
+}
+
+/* Android apps may not list links over netlink, which if_nameindex() needs;
+ * SIOCGIFCONF still lists the interfaces that have an IPv4 address. */
+static unsigned int update_if_table_ifconf( void )
+{
+    unsigned int append_count = 0;
+    struct ifreq reqs[32], *req;
+    struct ifconf conf;
+    int fd;
+
+    if ((fd = socket( PF_INET, SOCK_DGRAM, 0 )) == -1) return 0;
+    conf.ifc_len = sizeof(reqs);
+    conf.ifc_req = reqs;
+    if (ioctl( fd, SIOCGIFCONF, &conf ))
+    {
+        ERR( "SIOCGIFCONF failed, errno %d.\n", errno );
+        close( fd );
+        return 0;
+    }
+    for (req = reqs; (char *)(req + 1) <= (char *)reqs + conf.ifc_len; req++)
+    {
+        struct ifreq index_req = *req;
+
+        if (ioctl( fd, SIOCGIFINDEX, &index_req )) continue;
+        if (!find_entry_from_index( index_req.ifr_ifindex ) && add_entry( index_req.ifr_ifindex, req->ifr_name ))
+            ++append_count;
+    }
+    close( fd );
+    return append_count;
+}
+
 static unsigned int update_if_table( void )
 {
     struct if_nameindex *indices, *entry;
@@ -315,6 +438,7 @@ static unsigned int update_if_table( void )
     indices = if_nameindex();
     if (!indices)
     {
+        if (errno == EACCES || errno == EPERM) return update_if_table_ifconf();
         ERR( "if_nameindex failed, errno %d.\n", errno );
         return 0;
     }
